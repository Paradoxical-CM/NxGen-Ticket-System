{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nxgen-ticketing/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nx-gen-ticketing/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nx-gen-ticketing",
  "projects": {
    "authentication": {
      "type": "application",
      "root": "apps/authentication",
      "entryFile": "main",
      "sourceRoot": "apps/authentication/src",
      "compilerOptions": {
        "tsConfigPath": "apps/authentication/tsconfig.app.json"
      }
    },
    "guards": {
      "type": "library",
      "root": "libs/guards",
      "entryFile": "index",
      "sourceRoot": "libs/guards/src",
      "compilerOptions": {
        "tsConfigPath": "libs/guards/tsconfig.lib.json"
      }
    },
    "library": {
      "type": "library",
      "root": "libs/library",
      "entryFile": "index",
      "sourceRoot": "libs/library/src",
      "compilerOptions": {
        "tsConfigPath": "libs/library/tsconfig.lib.json"
      }
    },
    "ticketing-service": {
      "type": "application",
      "root": "apps/ticketing-service",
      "entryFile": "main",
      "sourceRoot": "apps/ticketing-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ticketing-service/tsconfig.app.json"
      }
    }
  }
}
